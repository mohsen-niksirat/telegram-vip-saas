# --- Telegram bot ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://vip:vip@db:5432/vip

# --- Public URLs ---
# Base URL where Telegram sends webhook updates
WEBHOOK_BASE_URL=https://example.com
# Base URL of the Telegram mini-app / web app
WEBAPP_BASE_URL=https://example.com/app

# --- Payment providers (optional) ---
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=
NOWPAYMENTS_API_KEY=

# --- Admin REST API ---
# Token required by admin API endpoints, sent as the `X-API-Token` header
# (and used to log into the web dashboard).
API_TOKEN=change-me

# --- Referral program ---
# Bonus days granted to a referrer each time a referred user buys an active subscription.
REFERRAL_BONUS_DAYS=3
